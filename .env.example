# ============================================================
#  La Birriaza - Bot de pedidos por WhatsApp
#  Copia este archivo como .env y llena los valores.
# ============================================================

# --- Servidor ---
PORT=3000
# URL pública con HTTPS donde corre el servidor (Railway/Render/VPS).
# Se usa para mandar la imagen de datos de pago por WhatsApp.
PUBLIC_URL=https://tu-app.up.railway.app
# Carpeta donde se guarda la base de datos SQLite
DATA_DIR=./data
TZ=America/Mexico_City

# --- WhatsApp Cloud API (Meta) ---
# Se obtienen en developers.facebook.com > tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Palabra secreta que tú inventas y pegas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-esta-palabra
# Clave secreta de la app (Configuración de la app > Básica). Sirve para validar
# que los mensajes del webhook realmente vienen de Meta. Muy recomendado.
WHATSAPP_APP_SECRET=

# --- Panel de ventas ---
PANEL_PASSWORD=cambia-esta-contrasena
# Cadena larga y aleatoria para firmar las sesiones del panel
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# --- Agente de impresión ---
# El mismo valor se pone en el agente que corre en la PC del restaurante
PRINT_AGENT_TOKEN=pon-aqui-otra-cadena-larga

# --- Simulador web (/simulador) para probar sin WhatsApp ---
SIMULATOR_ENABLED=true
# Si los pedidos del simulador también se mandan a imprimir
SIMULATOR_PRINTS=true

# --- Restaurante ---
RESTAURANT_NAME=La Birriaza
RESTAURANT_SLOGAN=Una experiencia para compartir
RESTAURANT_DIRECCION=Calle Reforma 12, Santa Julia, 73310 Zacatlán, Pue.
# Horario de atención (24 h). Vacío = siempre abierto. Ej: 12:00-22:00
HORARIO=
# Teléfono para "Hablar con alguien"
TELEFONO_CONTACTO=797 106 6269

# --- Envío ---
# Costo fijo si no hay zonas o si el cliente escribe la dirección en vez de mandar ubicación
ENVIO_COSTO=20
# Opcional: coordenadas del restaurante y zonas por distancia "km:costo,km:costo"
# Ej: ENVIO_ZONAS=2:20,4:30,6:45  (más de 6 km = fuera de cobertura)
RESTAURANT_LAT=
RESTAURANT_LNG=
ENVIO_ZONAS=

# --- Datos para transferencia ---
PAGO_BANCO=Mercado Pago W
PAGO_TITULAR=Gustavo Ignacio Aco Monroy
PAGO_CLABE=722969014746864643

# --- Promociones (texto del botón "Ver promociones"). Usa \n para saltos de línea ---
PROMOCIONES=Martes de quesabirria: 2x$60 🌮\nCombo birriamen + agua del día: $120

# --- Impresión de la comanda ---
# Columnas del papel: 48 para 80 mm, 32 para 58 mm
TICKET_COLS=48
# native = QR por comando de la impresora (la mayoría lo soporta)
# image  = QR como imagen (para impresoras que no imprimen QR nativo)
TICKET_QR_MODE=native
# Página de códigos para acentos: cp850 o none (quita acentos)
TICKET_CODEPAGE=cp850
TICKET_LOGO=true
